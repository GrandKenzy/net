; Servidor HTTP local de archivos estaticos. El backend de sockets se
; selecciona dentro de server.bg segun el target elegido.

#if OS, "windows"
clause System "windows"
#elif OS, "linux"
clause System "linux"
#else
clause System "auto"
#end

#if ARCH, "amd"
clause Arch "amd"
#elif ARCH, "x86"
clause Arch "x86"
#elif ARCH, "arm"
clause Arch "arm"
#elif ARCH, "riscv32"
clause Arch "riscv32"
#elif ARCH, "riscv64"
clause Arch "riscv64"
#else
clause Arch "auto"
#end

; Shared native ABIs; Net does not redeclare socket syscalls.
library string as String
#if OS, "windows"
library windows as Platform
#elif OS, "linux"
library gnulibrary as Platform
#end

import { HttpServer } from server

@unsafe
func main() int32:
    root: chain = "."
    host: chain = "127.0.0.1"
    server: HttpServer = HttpServer(
        $root[0],
        1,
        $host[0],
        9,
        8000,
        10000,
        8192
    )
    return server.run()
