; Backend TCP POSIX para Linux. Mantiene la misma interfaz pública que
; winsock.bg para que los clientes no conozcan el ABI nativo del sistema.

clause System "linux"
clause Privacy "public"

public SOCKET_ERROR: const int32 = -1
; socket(2) se declara con retorno usize para conservar el contrato común.
; En el ABI Linux x64, -1 retornado por la función C llega como 0xffffffff.
public INVALID_SOCKET: const usize = 4294967295

public AF_INET: const int32 = 2
public AF_INET6: const int32 = 10
public SOCK_STREAM: const int32 = 1
public IPPROTO_TCP: const int32 = 6

; Linux coloca ai_addr antes de ai_canonname en addrinfo.
@align(8)
public struct ADDRINFO:
    ai_flags: int32
    ai_family: int32
    ai_socktype: int32
    ai_protocol: int32
    ai_addrlen: int32
    ai_addr *: const char
    ai_canonname *: const char
    ai_next *: ADDRINFO

extern c "c":
    getaddrinfo(
        node *: const char,
        service *: const char,
        hints *: ADDRINFO,
        result **: ADDRINFO
    ) int32

    freeaddrinfo(result *: ADDRINFO) void

    socket(
        af: int32,
        kind: int32,
        protocol: int32
    ) usize

    connect(
        sock: usize,
        data *: const char,
        length: int32
    ) int32
    bind(
        sock: usize,
        data *: void,
        length: int32
    ) int32
    listen(sock: usize, backlog: int32) int32
    accept(
        sock: usize,
        data *: char,
        length *: int32
    ) usize
    setsockopt(
        sock: usize,
        level: int32,
        option: int32,
        value *: void,
        value_length: int32
    ) int32

    send(
        sock: usize,
        buffer *: const char,
        length: int32,
        flags_: int32
    ) int32

    recv(
        sock: usize,
        buffer *: char,
        length: int32,
        flags_: int32
    ) int32

    close(file_descriptor: usize) int32
    htons(port: int32) uint16

@unsafe
public func startup() int32:
    ; POSIX no necesita inicialización global del subsistema de sockets.
    return 0

@unsafe
public func cleanup() int32:
    return 0

@unsafe
public func network_port(port: int32) uint16:
    return htons(port)

@unsafe
public func open_socket(family: int32, kind: int32, protocol: int32) usize:
    return socket(family, kind, protocol)

@unsafe
public func connect_socket(handle: usize, address *: const char, length: int32) int32:
    return connect(handle, address, length)

@unsafe
public func bind_socket(handle: usize, address *: void, length: int32) int32:
    return bind(handle, address, length)

@unsafe
public func listen_socket(handle: usize, backlog: int32) int32:
    return listen(handle, backlog)

@unsafe
public func accept_socket(handle: usize) usize:
    return accept(handle, Null, Null)

@align(8)
private struct SocketTimeval:
    seconds: int64
    microseconds: int64

@unsafe
public func configure_socket_timeout(handle: usize, timeout_ms: int32) int32:
    if timeout_ms < 1:
        return -1
    timeout: SocketTimeval
    timeout.seconds = timeout_ms / 1000
    timeout.microseconds = (timeout_ms % 1000) * 1000
    socket_level: int32 = 1
    receive_option: int32 = 20
    send_option: int32 = 21
    receive_result: int32 = setsockopt(handle, socket_level, receive_option, $timeout, 16)
    send_result: int32 = setsockopt(handle, socket_level, send_option, $timeout, 16)
    if receive_result != 0 || send_result != 0:
        return -1
    return 0

@unsafe
public func send_socket(handle: usize, buffer *: const char, length: int32) int32:
    return send(handle, buffer, length, 0)

@unsafe
public func recv_socket(handle: usize, buffer *: char, length: int32) int32:
    return recv(handle, buffer, length, 0)

@unsafe
public func close_socket(handle: usize) int32:
    return close(handle)

@unsafe
public func resolve(
    node *: const char,
    service *: const char,
    hints *: ADDRINFO,
    result **: ADDRINFO
) int32:
    return getaddrinfo(node, service, hints, result)

@unsafe
public func release_addrinfo(result *: ADDRINFO) void:
    freeaddrinfo(result)
    return

public class Socket:

    func __init__(
        sock: usize,
        addr *: const char,
        addrlen: int32
    ) void:
        self.sock = sock
        self.addr = addr
        self.addrlen = addrlen
        self.closed = false

    @unsafe
    func connect() int32:
        if self.closed:
            return SOCKET_ERROR

        if self.sock == INVALID_SOCKET:
            return SOCKET_ERROR

        return connect_socket(self.sock, self.addr, self.addrlen)

    @unsafe
    func send(buf *: const char, len: int32) int32:
        if self.closed:
            return SOCKET_ERROR

        if self.sock == INVALID_SOCKET:
            return SOCKET_ERROR

        return send_socket(self.sock, buf, len)

    @unsafe
    func recv(buf *: char, len: int32) int32:
        if self.closed:
            return SOCKET_ERROR

        if self.sock == INVALID_SOCKET:
            return SOCKET_ERROR

        return recv_socket(self.sock, buf, len)

    @unsafe
    func close() int32:
        if self.closed:
            return 0

        if self.sock == INVALID_SOCKET:
            self.closed = true
            return SOCKET_ERROR

        close_socket(self.sock)
        self.closed = true
        self.sock = 0
        return 0

    @unsafe
    func __deletion__() void:
        self.close()
        return
