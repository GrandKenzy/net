; Cliente HTTP/1.1 para descargar recursos a archivos.
; Los códigos públicos viven en result.bg; aquí se traducen los fallos de cada
; frontera (URL, transporte, framing y archivo) a ese contrato común.

#if OS, "windows"
clause System 'windows'
#elif OS, "linux"
clause System 'linux'
#else
clause System 'auto'
#end

#if ARCH, "amd"
clause Arch 'amd'
#elif ARCH, "x86"
clause Arch 'x86'
#elif ARCH, "arm"
clause Arch 'arm'
#elif ARCH, "riscv32"
clause Arch 'riscv32'
#elif ARCH, "riscv64"
clause Arch 'riscv64'
#else
clause Arch 'auto'
#end

import { url_format } from url
import { parse_framing } from headers
import { https_get_to_file } from https
import {
    NET_CONNECTION,
    NET_FILE,
    NET_HEADER,
    NET_INVALID_ARGUMENT,
    NET_LIMIT,
    NET_OK,
    NET_PROTOCOL,
    NET_RECEIVE,
    NET_REDIRECT,
    NET_STATUS
} from result
import {
    close_output,
    open_output,
    write_output
} from file

; Sockets, DNS and timeouts use the canonical platform library.

@unsafe
private func net_startup() int32:
    return Platform.Startup()

@unsafe
private func net_cleanup() void:
    Platform.Cleanup()
    return

@unsafe
private func net_socket(family: int32, kind: int32, protocol: int32) usize:
    return Platform.Open(family, kind, protocol)

@unsafe
private func net_connect(handle: usize, address *: const char, length: int32) int32:
    return Platform.Connect(handle, address, length)

@unsafe
private func net_send(handle: usize, buffer *: const char, length: int32) int32:
    return Platform.Send(handle, buffer, length)

@unsafe
private func net_recv(handle: usize, buffer *: char, length: int32) int32:
    return Platform.Recv(handle, buffer, length)

@unsafe
private func net_close(handle: usize) void:
    Platform.Close(handle)
    return

@unsafe
private func append_chain(
    target: char[],
    target_length: Len_t,
    target_size: Size_t,
    position: int32,
    value: chain,
    value_length: Len_t
) int32:
    index: usize = 0
    cursor: int32 = position
    while index < value_length && value[index] != 0:
        if cursor >= 4095:
            return -1
        target[cursor] = value[index]
        cursor += 1
        index += 1
    target[cursor] = "\0"
    return cursor

@unsafe
private func append_chars(
    target: char[],
    target_length: Len_t,
    target_size: Size_t,
    position: int32,
    value: char[],
    value_length: Len_t,
    value_size: Size_t
) int32:
    if value_size != 1:
        return -1
    index: usize = 0
    cursor: int32 = position
    while index < value_length && value[index] != 0:
        if cursor >= 4095:
            return -1
        target[cursor] = value[index]
        cursor += 1
        index += 1
    target[cursor] = "\0"
    return cursor

@unsafe
private func header_is_chunked(header: char[], length: Len_t, size: Size_t) bool:
    if size != 1:
        return false

    c: char = "c"
    h: char = "h"
    u: char = "u"
    n: char = "n"
    k: char = "k"
    e: char = "e"
    d: char = "d"
    zero: char = "\0"
    index: usize = 0
    while index + 7 <= length && header[index] != zero:
        if String.char_to_lower(header[index]) == c && String.char_to_lower(header[index + 1]) == h && String.char_to_lower(header[index + 2]) == u && String.char_to_lower(header[index + 3]) == n && String.char_to_lower(header[index + 4]) == k && String.char_to_lower(header[index + 5]) == e && String.char_to_lower(header[index + 6]) == d:
            return true
        index += 1
    return false

@unsafe
private func hex_digit(value: char) int32:
    digits: chain = "0123456789abcdef"
    lowered: char = String.char_to_lower(value)
    index: int32 = 0
    while index < 16:
        if lowered == digits[index]:
            return index
        index += 1
    return -1

@unsafe
private func header_content_length(header: char[], length: Len_t, size: Size_t) int32:
    if size != 1:
        return -1

    c: char = "c"
    h: char = "h"
    o: char = "o"
    n: char = "n"
    t: char = "t"
    e: char = "e"
    l: char = "l"
    dash: char = "-"
    g: char = "g"
    colon: char = ":"
    space: char = " "
    tab: char = "\t"
    value_text: char[32]
    parsed: int32 = 0
    zero: char = "0"
    nul: char = "\0"
    nine: char = "9"
    digits: chain = "0123456789"
    newline: char = "\n"
    carriage_return: char = "\r"
    index: usize = 0
    while index + 15 <= length:
        if header[index] == nul:
            break
        if (index == 0 || header[index - 1] == newline) && String.char_to_lower(header[index]) == c && String.char_to_lower(header[index + 1]) == o && String.char_to_lower(header[index + 2]) == n && String.char_to_lower(header[index + 3]) == t && String.char_to_lower(header[index + 4]) == e && String.char_to_lower(header[index + 5]) == n && String.char_to_lower(header[index + 6]) == t && header[index + 7] == dash && String.char_to_lower(header[index + 8]) == l && String.char_to_lower(header[index + 9]) == e && String.char_to_lower(header[index + 10]) == n && String.char_to_lower(header[index + 11]) == g && String.char_to_lower(header[index + 12]) == t && String.char_to_lower(header[index + 13]) == h && header[index + 14] == colon:
            value_index: usize = index + 15
            while value_index < length && (header[value_index] == space || header[value_index] == tab):
                value_index += 1
            digit_count: usize = 0
            while value_index < length && digit_count < 31 && String.is_digit(header[value_index]):
                value_text[digit_count] = header[value_index]
                digit_count += 1
                value_index += 1
            value_text[digit_count] = "\0"
            if digit_count == 0:
                return -2
            ; Un campo malformado no se trata como longitud desconocida.
            if value_index < length && String.is_digit(header[value_index]):
                return -2
            while value_index < length && (header[value_index] == space || header[value_index] == tab):
                value_index += 1
            if value_index >= length || header[value_index] != carriage_return:
                return -2
            value_index = 0
            while value_index < digit_count:
                if value_text[value_index] < zero || value_text[value_index] > nine:
                    return -1
                digit_index: usize = 0
                digit_value: int32 = 0
                while digit_index < 10:
                    if value_text[value_index] == digits[digit_index]:
                        break
                    digit_index += 1
                    digit_value += 1
                ; No permitir overflow de int32 en Content-Length.
                if parsed > 214748364 || (parsed == 214748364 && digit_value > 7):
                    return -2
                parsed = parsed * 10 + digit_value
                value_index += 1
            return parsed
        index += 1
    return -1

@unsafe
private func header_location(header: char[], length: Len_t, size: Size_t, output *: char) int32:
    if size != 1:
        return -1
    l: char = "l"
    o: char = "o"
    c: char = "c"
    a: char = "a"
    t: char = "t"
    i: char = "i"
    n: char = "n"
    g: char = "g"
    colon: char = ":"
    space: char = " "
    tab: char = "\t"
    cr: char = "\r"
    nl: char = "\n"
    zero: char = "\0"
    index: usize = 0
    while index + 9 <= length && header[index] != zero:
        if (index == 0 || header[index - 1] == nl) && String.char_to_lower(header[index]) == l && String.char_to_lower(header[index + 1]) == o && String.char_to_lower(header[index + 2]) == c && String.char_to_lower(header[index + 3]) == a && String.char_to_lower(header[index + 4]) == t && String.char_to_lower(header[index + 5]) == i && String.char_to_lower(header[index + 6]) == o && String.char_to_lower(header[index + 7]) == n && header[index + 8] == colon:
            value_index: usize = index + 9
            while value_index < length && (header[value_index] == space || header[value_index] == tab):
                value_index += 1
            output_length: int32 = 0
            while value_index < length && header[value_index] != cr && output_length < 2047:
                output[output_length] = header[value_index]
                output_length += 1
                value_index += 1
            output[output_length] = "\0"
            if value_index >= length || header[value_index] != cr:
                return -1
            if output_length == 0:
                return -1
            return output_length
        index += 1
    return -1

@unsafe
private func http_get_to_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    destination: char[],
    destination_length: Len_t,
    destination_size: Size_t,
    timeout_ms: int32,
    max_body_bytes: int32,
    method: int32,
    write_body: bool,
    redirect *: char
) int32:
    if url_format(source) != 0:
        return -1
    if source_size != 1 || destination_size != 1 || (method != 0 && method != 1) || max_body_bytes < 1:
        return -2

    ; Evitar leer una URL residual cuando una respuesta 3xx no tenga Location.
    redirect[0] = "\0"
    colon: char = ":"
    slash: char = "/"
    question: char = "?"
    hash: char = "#"
    zero: char = "0"
    at_sign: char = "@"
    left_bracket: char = "["
    right_bracket: char = "]"

    source_real_length: usize = 0
    while source_real_length < source_length && source[source_real_length] != 0:
        source_real_length += 1

    scheme_end: usize = 1
    while scheme_end < source_real_length && source[scheme_end] != colon:
        scheme_end += 1
    if scheme_end + 3 >= source_real_length:
        return -2

    authority_start: usize = scheme_end + 3
    authority_end: usize = authority_start
    while authority_end < source_real_length:
        if source[authority_end] == slash || source[authority_end] == question || source[authority_end] == hash:
            break
        authority_end += 1

    if authority_end == authority_start:
        return -2

    host: char[512]
    dns_host: char[512]
    service: char[6] = "80"
    host_length: usize = 0
    dns_host_length: usize = 0
    port_start: usize = authority_end
    port_value_start: usize = authority_end
    cursor: usize = authority_start
    if source[authority_start] == left_bracket:
        closing_bracket: usize = authority_start + 1
        while closing_bracket < authority_end && source[closing_bracket] != right_bracket:
            if source[closing_bracket] == at_sign:
                return -2
            closing_bracket += 1
        if closing_bracket >= authority_end || closing_bracket == authority_start + 1:
            return -2
        cursor = authority_start
        while cursor <= closing_bracket:
            if host_length >= 511:
                return -2
            host[host_length] = source[cursor]
            host_length += 1
            cursor += 1
        cursor = authority_start + 1
        while cursor < closing_bracket:
            if dns_host_length >= 511:
                return -2
            dns_host[dns_host_length] = source[cursor]
            dns_host_length += 1
            cursor += 1
        if closing_bracket + 1 < authority_end:
            if source[closing_bracket + 1] != colon:
                return -2
            port_start = closing_bracket + 1
            port_value_start = closing_bracket + 2
    else:
        while cursor < authority_end:
            if source[cursor] == at_sign:
                return -2
            if source[cursor] == colon:
                port_start = cursor
                port_value_start = cursor + 1
                break
            cursor += 1
        cursor = authority_start
        while cursor < port_start:
            if host_length >= 511 || dns_host_length >= 511:
                return -2
            host[host_length] = source[cursor]
            dns_host[dns_host_length] = source[cursor]
            host_length += 1
            dns_host_length += 1
            cursor += 1

    if host_length == 0:
        return -2
    host[host_length] = "\0"
    dns_host[dns_host_length] = "\0"

    if port_value_start < authority_end:
        port_length: usize = 0
        cursor = port_value_start
        while cursor < authority_end:
            if port_length >= 5 || String.is_digit(source[cursor]) == false:
                return -2
            service[port_length] = source[cursor]
            port_length += 1
            cursor += 1
        if port_length == 0:
            return -2
        service[port_length] = "\0"
        port_value: usize = String.parse_uint(service)
        if port_value == 0 || port_value > 65535:
            return -2

    path: char[2048]
    path_length: usize = 0
    path_start: usize = authority_end
    if path_start == source_real_length:
        path[0] = slash
        path[1] = "\0"
    else:
        if source[path_start] == hash:
            path[0] = slash
            path[1] = "\0"
        else:
            if source[path_start] == question:
                path[0] = slash
                path_length = 1
            cursor = path_start
            while cursor < source_real_length && source[cursor] != hash:
                if path_length >= 2046:
                    return -2
                path[path_length] = source[cursor]
                path_length += 1
                cursor += 1
            path[path_length] = "\0"

    request: char[4096]
    request_length: int32 = 0
    if method == 1:
        request_length = append_chain(request, 0, "HEAD ")
    else:
        request_length = append_chain(request, 0, "GET ")
    request_length = append_chars(request, request_length, path)
    request_length = append_chain(request, request_length, " HTTP/1.1\r\nHost: ")
    request_length = append_chars(request, request_length, host)
    request_length = append_chain(request, request_length, "\r\nConnection: close\r\nUser-Agent: Bagron/1.0\r\n\r\n")
    if request_length < 0:
        return -5

    startup_result: int32 = net_startup()
    if startup_result != 0:
        return -4

    socket_handle: usize = Platform.OpenTcpHost($dns_host[0], $service[0], timeout_ms)
    if socket_handle == Platform.INVALID_SOCKET:
        net_cleanup()
        return -4

    ; TCP puede aceptar solo una parte del buffer en cada llamada.
    sent_total: int32 = 0
    while sent_total < request_length:
        sent: int32 = net_send(
            socket_handle,
            $request[sent_total],
            request_length - sent_total
        )
        if sent <= 0:
            net_close(socket_handle)
            net_cleanup()
            return -5
        sent_total += sent

    header: char[8192]
    read_buffer: char[4096]
    output_buffer: char[4096]
    header_length: int32 = 0
    output_length: int32 = 0
    body_length: int32 = -1
    body_received: int32 = 0
    header_ready: bool = false
    response_initialized: bool = false
    download_complete: bool = false
    chunked: bool = false
    chunk_state: int32 = 0
    chunk_remaining: int32 = 0
    chunk_value: int32 = 0
    chunk_has_digit: bool = false
    chunk_extension: bool = false
    trailer_cr: bool = false
    trailer_empty: bool = true
    framing_error: bool = false
    cr: char = "\r"
    nl: char = "\n"
    semicolon: char = ";"

#if OS, "windows"
    output_handle *: void = Null
#elif OS, "linux"
    output_handle: usize = 4294967295
#end

    status_h: char = "h"
    status_t: char = "t"
    status_p: char = "p"
    status_space: char = " "
    status_two: char = "2"
    status_three: char = "3"
    status_zero: char = "0"

    while download_complete == false:
        received: int32 = net_recv(socket_handle, $read_buffer[0], 4096)
        if received < 0:
            if response_initialized && write_body:
                close_output(output_handle)
            net_close(socket_handle)
            net_cleanup()
            return NET_RECEIVE
        if received == 0:
            break

        received_length: int32 = received
        read_index: int32 = 0
        if header_ready == false:
            while read_index < received_length:
                if header_length >= 8191:
                    net_close(socket_handle)
                    net_cleanup()
                    return -8
                header[header_length] = read_buffer[read_index]
                header_length += 1
                read_index += 1
                if header_length >= 4:
                    if header[header_length - 4] == cr:
                        if header[header_length - 3] == nl:
                            if header[header_length - 2] == cr:
                                if header[header_length - 1] == nl:
                                    header[header_length] = "\0"
                                    header_ready = true
                                    break

        if header_ready && response_initialized == false:
            if header_length < 12:
                net_close(socket_handle)
                net_cleanup()
                return NET_HEADER
            if String.char_to_lower(header[0]) != status_h || String.char_to_lower(header[1]) != status_t || String.char_to_lower(header[2]) != status_t || String.char_to_lower(header[3]) != status_p || header[8] != status_space:
                net_close(socket_handle)
                net_cleanup()
                return NET_PROTOCOL
            if String.is_digit(header[9]) == false || String.is_digit(header[10]) == false || String.is_digit(header[11]) == false:
                net_close(socket_handle)
                net_cleanup()
                return NET_PROTOCOL
            if header[9] != status_two:
                net_close(socket_handle)
                net_cleanup()
                if header[9] == status_three:
                    if header_location(header, redirect) < 0:
                        return NET_HEADER
                    return NET_REDIRECT
                return NET_STATUS
            framing: int32 = parse_framing(header, $body_length)
            if framing < 0:
                net_close(socket_handle)
                net_cleanup()
                return NET_HEADER
            chunked = framing == 2
            if body_length > max_body_bytes:
                net_close(socket_handle)
                net_cleanup()
                return NET_LIMIT
            if write_body == false:
                response_initialized = true
                download_complete = true
                continue
#if OS, "windows"
            if open_output($destination[0], $output_handle) == false:
                net_close(socket_handle)
                net_cleanup()
                return NET_FILE
#elif OS, "linux"
            if open_output($destination[0], $output_handle) == false:
                net_close(socket_handle)
                net_cleanup()
                return NET_FILE
#end
            response_initialized = true
            if chunked == false && body_length == 0:
                download_complete = true
        elif header_ready == false:
            continue

        while read_index < received_length && download_complete == false:
            if chunked:
                current: char = read_buffer[read_index]
                read_index += 1
                if chunk_state == 0:
                    if chunk_extension:
                        if current == cr:
                            chunk_state = 1
                        elif current == nl:
                            framing_error = true
                            break
                    elif current == semicolon:
                        if chunk_has_digit == false:
                            framing_error = true
                            break
                        chunk_extension = true
                    elif current == cr:
                        if chunk_has_digit == false:
                            framing_error = true
                            break
                        chunk_state = 1
                    else:
                        digit: int32 = hex_digit(current)
                        if digit < 0 || chunk_value > 134217727:
                            framing_error = true
                            break
                        chunk_value = chunk_value * 16 + digit
                        chunk_has_digit = true
                elif chunk_state == 1:
                    if current != nl:
                        framing_error = true
                        break
                    if chunk_value == 0:
                        chunk_state = 3
                        trailer_cr = false
                        trailer_empty = true
                    else:
                        chunk_remaining = chunk_value
                        chunk_state = 2
                elif chunk_state == 2:
                    if body_received >= max_body_bytes:
                        close_output(output_handle)
                        net_close(socket_handle)
                        net_cleanup()
                        return NET_LIMIT
                    output_buffer[output_length] = current
                    output_length += 1
                    body_received += 1
                    chunk_remaining -= 1
                    if output_length == 4096:
                        if write_output(output_handle, $output_buffer[0], output_length) == false:
                            close_output(output_handle)
                            net_close(socket_handle)
                            net_cleanup()
                            return NET_FILE
                        output_length = 0
                    if chunk_remaining == 0:
                        chunk_state = 4
                elif chunk_state == 3:
                    if trailer_cr:
                        if current != nl:
                            framing_error = true
                            break
                        if trailer_empty:
                            download_complete = true
                            break
                        trailer_cr = false
                        trailer_empty = true
                    elif current == cr:
                        trailer_cr = true
                    elif current == nl:
                        framing_error = true
                        break
                    else:
                        trailer_empty = false
                elif chunk_state == 4:
                    if current != cr:
                        framing_error = true
                        break
                    chunk_state = 5
                elif chunk_state == 5:
                    if current != nl:
                        framing_error = true
                        break
                    chunk_state = 0
                    chunk_remaining = 0
                    chunk_value = 0
                    chunk_has_digit = false
                    chunk_extension = false
                else:
                    framing_error = true
                    break
                continue
            if body_length >= 0 && body_received >= body_length:
                download_complete = true
                break
            if body_received >= max_body_bytes:
                close_output(output_handle)
                net_close(socket_handle)
                net_cleanup()
                return NET_LIMIT
            output_buffer[output_length] = read_buffer[read_index]
            output_length += 1
            body_received += 1
            read_index += 1
            if output_length == 4096:
                if write_output(output_handle, $output_buffer[0], output_length) == false:
                    close_output(output_handle)
                    net_close(socket_handle)
                    net_cleanup()
                    return NET_FILE
                output_length = 0
            if body_length >= 0 && body_received >= body_length:
                download_complete = true
                break

        if framing_error:
            close_output(output_handle)
            net_close(socket_handle)
            net_cleanup()
            return NET_PROTOCOL

    if header_ready == false:
        net_close(socket_handle)
        net_cleanup()
        return NET_HEADER
    if response_initialized == false:
        net_close(socket_handle)
        net_cleanup()
        return NET_HEADER
    if write_body == false:
        net_close(socket_handle)
        net_cleanup()
        return NET_OK
    if chunked && download_complete == false:
        close_output(output_handle)
        net_close(socket_handle)
        net_cleanup()
        return NET_RECEIVE
    if chunked == false && body_length >= 0 && body_received < body_length:
        close_output(output_handle)
        net_close(socket_handle)
        net_cleanup()
        return NET_RECEIVE
    if output_length > 0 && write_output(output_handle, $output_buffer[0], output_length) == false:
        close_output(output_handle)
        net_close(socket_handle)
        net_cleanup()
        return NET_FILE

    close_output(output_handle)
    net_close(socket_handle)
    net_cleanup()
    return NET_OK

public class HttpClient:
    @unsafe
    func __init__(timeout_ms: int32, max_redirects: int32, follow_redirects: bool) void:
        self.timeout_ms = timeout_ms
        self.max_redirects = max_redirects
        self.follow_redirects = follow_redirects
        ; Downloads are capped by default at 512 MiB.
        self.max_body_bytes = 536870912

    @unsafe
    func set_max_body_bytes(limit: int32) bool:
        if limit < 1:
            return false
        self.max_body_bytes = limit
        return true

    @unsafe
    func get_to_file(
        source: char[],
        source_length: Len_t,
        source_size: Size_t,
        destination: char[],
        destination_length: Len_t,
        destination_size: Size_t
    ) int32:
        if self.timeout_ms < 1 || self.max_redirects < 0:
            return -1
        format: int32 = url_format(source)
        if format == 1:
            return https_get_to_file(source, destination, self.timeout_ms, self.max_body_bytes)
        if format != 0:
            return -1
        current_url: char[2048]
        redirect_url: char[2048]
        current_length: int32 = 0
        source_index: usize = 0
        while source_index < source_length && source[source_index] != 0 && current_length < 2047:
            current_url[current_length] = source[source_index]
            current_length += 1
            source_index += 1
        if source_index < source_length && source[source_index] != 0:
            return NET_INVALID_ARGUMENT
        current_url[current_length] = "\0"
        redirects: int32 = 0
        while true:
            ; Una redireccion HTTP puede cambiar el esquema a HTTPS.
            current_format: int32 = url_format(current_url)
            if current_format == 1:
                return https_get_to_file(current_url, destination, self.timeout_ms, self.max_body_bytes)
            if current_format != 0:
                return NET_REDIRECT
            result: int32 = http_get_to_file(current_url, destination, self.timeout_ms, self.max_body_bytes, 0, true, $redirect_url[0])
            if result != NET_REDIRECT || self.follow_redirects == false:
                return result
            if redirects >= self.max_redirects:
                return NET_REDIRECT
            if url_format(redirect_url) < 0:
                return NET_REDIRECT
            current_length = 0
            source_index = 0
            while redirect_url[source_index] != 0 && current_length < 2047:
                current_url[current_length] = redirect_url[source_index]
                current_length += 1
                source_index += 1
            if redirect_url[source_index] != 0:
                return NET_REDIRECT
            current_url[current_length] = "\0"
            redirects += 1
        return NET_REDIRECT

    @unsafe
    func head(
        source: char[],
        source_length: Len_t,
        source_size: Size_t
    ) int32:
        if self.timeout_ms < 1 || self.max_redirects < 0:
            return NET_INVALID_ARGUMENT
        format: int32 = url_format(source)
        if format == 1:
            return NET_PROTOCOL
        if format != 0:
            return NET_INVALID_ARGUMENT
        current_url: char[2048]
        redirect_url: char[2048]
        empty_destination: char[1]
        current_length: int32 = 0
        source_index: usize = 0
        while source_index < source_length && source[source_index] != 0 && current_length < 2047:
            current_url[current_length] = source[source_index]
            current_length += 1
            source_index += 1
        if source_index < source_length && source[source_index] != 0:
            return NET_INVALID_ARGUMENT
        current_url[current_length] = "\0"
        redirects: int32 = 0
        while true:
            result: int32 = http_get_to_file(current_url, empty_destination, self.timeout_ms, self.max_body_bytes, 1, false, $redirect_url[0])
            if result != NET_REDIRECT || self.follow_redirects == false:
                return result
            if redirects >= self.max_redirects:
                return NET_REDIRECT
            if url_format(redirect_url) < 0:
                return NET_REDIRECT
            current_length = 0
            source_index = 0
            while redirect_url[source_index] != 0 && current_length < 2047:
                current_url[current_length] = redirect_url[source_index]
                current_length += 1
                source_index += 1
            if redirect_url[source_index] != 0:
                return NET_REDIRECT
            current_url[current_length] = "\0"
            redirects += 1
        return NET_REDIRECT

    @unsafe
    func __deletion__() void:
        return
