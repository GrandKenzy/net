; E/S de archivos HTTP a traves de las bibliotecas nativas de BagronLab.
; No se declaran externs ni se reutiliza close_socket para ficheros.

#if OS, "linux"
private mold NetFdBits:
    signed: int64
    unsigned: usize

private mold NetSmallBits:
    long: int64
    small: int32

@unsafe
public func open_output(file_name *: const char, result *: usize) bool:
    fd: int64 = Platform.open_cstr(-100, file_name, 577, 420)
    if fd < 0:
        return false
    bits: NetFdBits
    bits.signed = fd
    (result) = bits.unsigned
    return true

@unsafe
public func open_input(file_name *: const char, result *: usize) bool:
    fd: int64 = Platform.open_cstr(-100, file_name, 0, 0)
    if fd < 0:
        return false
    bits: NetFdBits
    bits.signed = fd
    (result) = bits.unsigned
    return true

; Returns 0 if the file is safely contained, 404 if absent, or 403 otherwise.
@unsafe
public func open_input_beneath(root *: const char, relative *: const char, result *: usize) int32:
    fd: int64 = Platform.open_read_beneath(root, relative)
    if fd == -2 || fd == -20:
        return 404
    if fd < 0:
        return 403
    bits: NetFdBits
    bits.signed = fd
    (result) = bits.unsigned
    return 0

@unsafe
public func input_size(handle: usize) int32:
    fd: NetFdBits
    fd.unsigned = handle
    end: int64 = Platform.lseek(fd.signed, 0, 2)
    if end < 0 || end > 2147483647:
        return -1
    if Platform.lseek(fd.signed, 0, 0) < 0:
        return -1
    result: NetSmallBits
    result.long = end
    return result.small

@unsafe
public func read_input(handle: usize, buffer *: char, count: int32) int32:
    if count < 0:
        return -1
    fd: NetFdBits
    fd.unsigned = handle
    size: NetFdBits
    size.signed = count
    result: int64 = Platform.read_chars(fd.signed, buffer, size.unsigned)
    if result < 0 || result > 2147483647:
        return -1
    bounded: NetSmallBits
    bounded.long = result
    return bounded.small

@unsafe
public func write_output(handle: usize, buffer *: const char, count: int32) bool:
    if count < 0:
        return false
    fd: NetFdBits
    fd.unsigned = handle
    remaining: int32 = count
    offset: int32 = 0
    while remaining > 0:
        size: NetFdBits
        size.signed = remaining
        written: int64 = Platform.write_chars(fd.signed, $buffer[offset], size.unsigned)
        if written == -4:
            continue
        if written <= 0 || written > remaining:
            return false
        bounded: NetSmallBits
        bounded.long = written
        offset += bounded.small
        remaining -= bounded.small
    return true

@unsafe
public func close_output(handle: usize) void:
    fd: NetFdBits
    fd.unsigned = handle
    Platform.close(fd.signed)
    return

@unsafe
public func close_input(handle: usize) void:
    fd: NetFdBits
    fd.unsigned = handle
    Platform.close(fd.signed)
    return

#elif OS, "windows"
private mold NetFileSizeBits:
    wide: int64
    low: int32
    unsigned: uint32

@unsafe
public func open_output(file_name *: const char, result **: void) bool:
    handle *: void = Platform.CreateFileA(file_name, Platform.GENERIC_WRITE, Platform.FILE_SHARE_READ_WRITE, Null, Platform.CREATE_ALWAYS, Platform.FILE_ATTRIBUTE_NORMAL, Null)
    if Platform.GetFileType(handle) != Platform.FILE_TYPE_DISK:
        return false
    (result) = handle
    return true

@unsafe
public func open_input(file_name *: const char, result **: void) bool:
    handle *: void = Platform.CreateFileA(file_name, Platform.GENERIC_READ, Platform.FILE_SHARE_READ_WRITE, Null, Platform.OPEN_EXISTING, Platform.FILE_ATTRIBUTE_NORMAL, Null)
    if Platform.GetFileType(handle) != Platform.FILE_TYPE_DISK:
        return false
    (result) = handle
    return true

@unsafe
public func input_size(handle *: void) int32:
    size: int64 = 0
    if Platform.GetFileSizeEx(handle, $size) == 0 || size < 0 || size > 2147483647:
        return -1
    bits: NetFileSizeBits
    bits.wide = size
    return bits.low

@unsafe
public func read_input(handle *: void, buffer *: char, count: int32) int32:
    if count < 0:
        return -1
    count_bits: NetFileSizeBits
    count_bits.low = count
    amount: uint32 = count_bits.unsigned
    got: uint32 = 0
    if Platform.ReadFile(handle, buffer, amount, $got, Null) == 0:
        return -1
    bits: NetFileSizeBits
    bits.unsigned = got
    return bits.low

@unsafe
public func write_output(handle *: void, buffer *: const char, count: int32) bool:
    if count < 0:
        return false
    remaining: int32 = count
    offset: int32 = 0
    while remaining > 0:
        count_bits: NetFileSizeBits
        count_bits.low = remaining
        amount: uint32 = count_bits.unsigned
        sent: uint32 = 0
        if Platform.WriteFile(handle, $buffer[offset], amount, $sent, Null) == 0 || sent == 0:
            return false
        result: NetFileSizeBits
        result.unsigned = sent
        if result.low > remaining || result.low <= 0:
            return false
        remaining -= result.low
        offset += result.low
    return true

@unsafe
public func close_output(handle *: void) void:
    Platform.CloseHandle(handle)
    return

@unsafe
public func close_input(handle *: void) void:
    Platform.CloseHandle(handle)
    return
#end
