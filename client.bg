; Ejemplo de cliente HTTP/HTTPS de Bagron.

#if OS, "windows"
clause System "windows"
#elif OS, "linux"
clause System "linux"
#else
clause System "auto"
#end

#if ARCH, "amd"
clause Arch "amd"
#elif ARCH, "x86"
clause Arch "x86"
#elif ARCH, "arm"
clause Arch "arm"
#elif ARCH, "riscv32"
clause Arch "riscv32"
#elif ARCH, "riscv64"
clause Arch "riscv64"
#else
clause Arch "auto"
