; Shared native ABIs; Net does not redeclare socket syscalls.
library string as String
#if OS, "windows"
library windows as Platform
#elif OS, "linux"
library gnulibrary as Platform
#end

import { HttpClient } from http

@unsafe
func main() int32:
    client: HttpClient = HttpClient(10000, 5, true)
    return client.get_to_file(
        "http://127.0.0.1:8000/main.bg",
        "build/client_download.bg"
    )
