; Regression tests for exact URL scheme recognition.
; Exit code 0 means success; a nonzero exit code identifies the failed case.

#if OS, "windows"
clause System 'windows'
#elif OS, "linux"
clause System 'linux'
#else
clause System 'auto'
#end

#if ARCH, "amd"
clause Arch 'amd'
#elif ARCH, "x86"
clause Arch 'x86'
#else
clause Arch 'auto'
#end

library string as String
import { url_format } from url

@unsafe
func main() int32:
    if url_format("http://example.com/") != 0:
        return 1
    if url_format("https://example.com/") != 1:
        return 2
    if url_format("ftp://example.com/") != 2:
        return 3

    ; Similar prefixes are not the same scheme.
    if url_format("httpx://example.com/") != -1:
        return 4
    if url_format("httpsx://example.com/") != -1:
        return 5
    if url_format("ftpplus://example.com/") != -1:
        return 6
    if url_format("http:/example.com/") != -1:
        return 7
    if url_format("other://example.com/") != -1:
        return 8
    return 0
